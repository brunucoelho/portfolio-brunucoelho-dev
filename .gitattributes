# Normaliza fim de linha para os arquivos de texto do projeto
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.txt    text eol=lf

# Arquivos binários — nunca aplicar conversão de EOL
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ico    binary
